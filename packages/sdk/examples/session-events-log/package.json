{
  "name": "@magio/example-session-events-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "magio": {
    "apiVersion": 1,
    "engines": {
      "magio": ">=2.5.3"
    },
    "contributes": {
      "panel": {
        "id": "session-events-log",
        "name": "Session Journal",
        "icon": "history"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "sessionEvents": {
        "events": [
          "turn-finished",
          "turn-failed",
          "permission-asked",
          "question-asked"
        ],
        "content": true
      }
    }
  },
  "dependencies": {
    "@magio/sdk": "workspace:*"
  }
}
