{
  "name": "magio",
  "displayName": "Magio",
  "description": "%extension.description%",
  "version": "1.2.0",
  "publisher": "fedaykindev",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gitcoffee-os/magio.git"
  },
  "qna": "https://discord.gg/ZYRSdnwwKA",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "gpt",
    "agent",
    "coding",
    "chatgpt",
    "groq",
    "assistant",
    "opencode",
    "magio"
  ],
  "icon": "assets/app-icon.png",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:magio.openSidebar",
    "onCommand:magio.attachExplorerToChat",
    "onCommand:magio.generateCommitMessage",
    "onView:magio.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magio",
          "title": "Magio",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "magio": [
        {
          "type": "webview",
          "id": "magio.chatView",
          "name": "%views.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "magio.openSidebar",
        "category": "Magio",
        "title": "%command.openSidebar.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "magio.focusChat",
        "category": "Magio",
        "title": "%command.focusChat.title%"
      },
      {
        "command": "magio.restartApi",
        "category": "Magio",
        "title": "%command.restartApi.title%"
      },
      {
        "command": "magio.showOpenCodeStatus",
        "category": "Magio",
        "title": "%command.showOpenCodeStatus.title%"
      },
      {
        "command": "magio.openAgentManager",
        "category": "Magio",
        "title": "%command.openAgentManager.title%",
        "icon": "$(repo-forked)"
      },
      {
        "command": "magio.openActiveSessionInEditor",
        "category": "Magio",
        "title": "%command.openActiveSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "magio.openNewSessionInEditor",
        "category": "Magio",
        "title": "%command.openNewSessionInEditor.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "magio.openCurrentOrNewSessionInEditor",
        "category": "Magio",
        "title": "%command.openCurrentOrNewSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "magio.addToContext",
        "category": "Magio",
        "title": "%command.addToContext.title%"
      },
      {
        "command": "magio.addLineComment",
        "category": "Magio",
        "title": "%command.addLineComment.title%"
      },
      {
        "command": "magio.submitLineComment",
        "category": "Magio",
        "title": "%command.submitLineComment.title%"
      },
      {
        "command": "magio.removeLineComment",
        "category": "Magio",
        "title": "%command.removeLineComment.title%",
        "icon": "$(close)"
      },
      {
        "command": "magio.explain",
        "category": "Magio",
        "title": "%command.explain.title%"
      },
      {
        "command": "magio.improveCode",
        "category": "Magio",
        "title": "%command.improveCode.title%"
      },
      {
        "command": "magio.newSession",
        "category": "Magio",
        "title": "%command.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "magio.showSettings",
        "category": "Magio",
        "title": "%command.showSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "magio.attachExplorerToChat",
        "category": "Magio",
        "title": "%command.attachExplorerToChat.title%"
      },
      {
        "command": "magio.generateCommitMessage",
        "category": "Magio",
        "title": "%command.generateCommitMessage.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-scm-titlebar.svg"
        }
      }
    ],
    "submenus": [
      {
        "id": "magio.submenu",
        "label": "Magio"
      }
    ],
    "keybindings": [
      {
        "command": "magio.showSettings",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "when": "magio.settingsShortcutTarget == chat && !inQuickOpen"
      },
      {
        "command": "magio.closeSettings",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "when": "magio.settingsShortcutTarget == settings && !inQuickOpen"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "magio.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "magio.submitLineComment",
          "group": "inline",
          "when": "commentController == magio.inlineComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "magio.removeLineComment",
          "group": "navigation",
          "when": "commentController == magio.inlineComments && commentThread == magioAttached"
        }
      ],
      "commandPalette": [
        {
          "command": "magio.submitLineComment",
          "when": "false"
        },
        {
          "command": "magio.removeLineComment",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "magio.submenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "magio.attachExplorerToChat",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "magio.openNewSessionInEditor",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "magio.newSession",
          "when": "view == magio.chatView",
          "group": "navigation@1"
        },
        {
          "command": "magio.openCurrentOrNewSessionInEditor",
          "when": "view == magio.chatView",
          "group": "navigation@2"
        },
        {
          "command": "magio.openAgentManager",
          "when": "view == magio.chatView",
          "group": "navigation@3"
        },
        {
          "command": "magio.showSettings",
          "when": "view == magio.chatView",
          "group": "navigation@4"
        }
      ],
      "magio.submenu": [
        {
          "command": "magio.explain"
        },
        {
          "command": "magio.improveCode"
        },
        {
          "command": "magio.addToContext"
        },
        {
          "command": "magio.addLineComment"
        }
      ]
    },
    "configuration": {
      "title": "Magio",
      "properties": {
        "magio.apiUrl": {
          "type": "string",
          "default": "",
          "description": "%configuration.apiUrl.description%"
        },
        "magio.opencodeBinary": {
          "type": "string",
          "default": "",
          "description": "%configuration.opencodeBinary.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun run build:extension && bun run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --main-fields=module,main",
    "build:webview": "VITE_OPENCODE_URL=/api vite build",
    "dev": "concurrently -n \"ext,web\" -c \"cyan,magenta\" \"bun run watch:extension\" \"bun run dev:webview\"",
    "dev:webview": "vite --host localhost --port 5173 --strictPort",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch --sourcemap --main-fields=module,main",
    "watch:webview": "vite build --watch",
    "type-check": "bun check -p tsconfig.json && bun check -b -p tsconfig.webview.json",
    "lint": "oxlint -c ../../oxlint.config.ts --report-unused-disable-directives src webview",
    "test": "node ../../scripts/run-isolated-tests.mjs src webview",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "~7.0.2",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@magio/ui": "workspace:*",
    "@opencode/client": "2.1.4",
    "adm-zip": "^0.6.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  }
}
